{
  "$schema": "../schema/plugin-v1.schema.json",
  "id": "github",
  "name": "GitHub",
  "version": "1.1.0",
  "description": "Reçus GitHub — compte personnel ou organisation. Le reçu est servi directement en PDF par GitHub, il n'y a rien à imprimer.",
  "homepage": "https://github.com",
  "maintainers": ["@cldt-fr"],
  "country": ["US", "EU"],
  "tags": ["saas", "developer"],
  "engine": ">=1.0.0",
  "allowedDomains": [
    "github.com",
    "*.github.com",
    "githubusercontent.com",
    "*.githubusercontent.com"
  ],
  "configSchema": {
    "username": {
      "type": "string",
      "label": "Identifiant ou e-mail GitHub",
      "required": true
    },
    "password": {
      "type": "password",
      "label": "Mot de passe",
      "required": true
    },
    "mfa": {
      "type": "totp",
      "label": "Secret de double authentification",
      "help": "Facultatif. Collez le secret affiché sous le QR code lors de l'activation de la 2FA, ou le lien otpauth:// entier. Si votre 2FA est une passkey ou un SMS, laissez vide : la connexion se terminera à la main dans la fenêtre."
    },
    "account": {
      "type": "string",
      "label": "Organisation",
      "help": "Laissez vide pour votre compte personnel, ou saisissez le nom de l'organisation à facturer.",
      "placeholder": "mon-organisation"
    }
  },
  "autofill": true,
  "checkAuth": [
    {
      "action": "if",
      "condition": {
        "variableIsSet": "config.account"
      },
      "then": [
        {
          "action": "navigate",
          "url": "https://github.com/organizations/{{config.account}}/settings/billing"
        }
      ],
      "else": [
        {
          "action": "navigate",
          "url": "https://github.com/settings/billing"
        }
      ]
    },
    {
      "action": "waitForNetworkIdle",
      "idleMs": 800,
      "timeout": 25000
    },
    {
      "action": "checkElementExists",
      "selector": "header button[data-login]",
      "description": "Le bouton du menu de compte n'existe que sur une page servie à une session ouverte ; une session morte renvoie sur /login, où il est absent."
    }
  ],
  "startAuth": [
    {
      "action": "navigate",
      "url": "https://github.com/login"
    },
    {
      "action": "waitForElement",
      "selector": "input[name='login']",
      "timeout": 20000
    },
    {
      "action": "type",
      "selector": "input[name='login']",
      "value": "{{config.username}}"
    },
    {
      "action": "type",
      "selector": "input[name='password']",
      "value": "{{secret.password}}"
    },
    {
      "action": "click",
      "selector": "input[name='commit'], button[type='submit']"
    },
    {
      "action": "waitForNavigation",
      "timeout": 30000
    },
    {
      "action": "if",
      "condition": {
        "elementExists": "input[name='app_otp']"
      },
      "then": [
        {
          "action": "type",
          "selector": "input[name='app_otp']",
          "value": "{{totp.mfa}}",
          "pressEnter": true,
          "description": "Étape TOTP, seulement quand GitHub la présente."
        },
        {
          "action": "waitForNavigation",
          "timeout": 30000
        }
      ]
    },
    {
      "action": "waitForElement",
      "selector": "header button[data-login]",
      "timeout": 120000,
      "description": "GitHub fait souvent suivre le mot de passe d'une vérification par appareil, d'une passkey ou d'un code envoyé par e-mail. Le plugin ne cherche pas à la franchir : il laisse la main à l'utilisateur, et attend simplement que la session soit ouverte."
    }
  ],
  "getDocuments": [
    {
      "action": "if",
      "condition": {
        "variableIsSet": "config.account"
      },
      "then": [
        {
          "action": "navigate",
          "url": "https://github.com/organizations/{{config.account}}/billing/history"
        }
      ],
      "else": [
        {
          "action": "navigate",
          "url": "https://github.com/account/billing/history"
        }
      ]
    },
    {
      "action": "waitForNetworkIdle",
      "idleMs": 800,
      "timeout": 30000
    },
    {
      "action": "extractAll",
      "selector": ".payment-history li.Box-row:has(.receipt a[href$='.pdf'])",
      "description": "Une ligne par paiement. Le :has() écarte d'emblée les lignes sans reçu téléchargeable, ce qui évite d'avoir à filtrer sur le statut — dont la cellule contient un doublon masqué pour les lecteurs d'écran.",
      "limit": 100,
      "fields": {
        "id": {
          "selector": ".id code",
          "regex": "[A-Z0-9]{6,}"
        },
        "date": {
          "selector": ".date",
          "regex": "\\d{4}-\\d{2}-\\d{2}"
        },
        "total": {
          "selector": ".amount",
          "regex": "\\S+"
        },
        "method": {
          "selector": ".method",
          "optional": true
        },
        "pdf": {
          "selector": ".receipt a[href$='.pdf']",
          "attribute": "href"
        }
      },
      "forEach": [
        {
          "action": "downloadPdf",
          "url": "{{item.pdf}}",
          "timeout": 60000,
          "document": {
            "id": "{{item.id}}",
            "date": "{{item.date}}",
            "total": "{{item.total}}",
            "number": "{{item.id}}",
            "issuer": "GitHub, Inc.",
            "type": "receipt",
            "metadata": {
              "paymentMethod": "{{item.method}}"
            }
          }
        }
      ]
    }
  ],
  "status": "unverified"
}
