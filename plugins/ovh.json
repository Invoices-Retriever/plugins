{
  "$schema": "../schema/plugin-v1.schema.json",
  "id": "ovh",
  "name": "OVHcloud",
  "version": "0.4.0",
  "description": "Factures OVHcloud. La connexion est vérifiée sur le portail réel ; les sélecteurs du tableau de facturation ne le sont pas encore — voir ovh.NOTES.md. Signalez-nous ce que vous trouvez.",
  "homepage": "https://www.ovhcloud.com",
  "maintainers": ["@cldt-fr"],
  "country": ["FR", "EU"],
  "tags": ["hosting", "cloud", "domains"],
  "engine": ">=1.0.0",
  "allowedDomains": ["ovhcloud.com", "*.ovhcloud.com", "ovh.com", "*.ovh.com"],
  "status": "unverified",
  "configSchema": {
    "region": {
      "type": "select",
      "label": "Région du compte",
      "help": "Visible dans l'adresse de votre espace client : manager.eu.ovhcloud.com pour l'Europe.",
      "required": true,
      "default": "eu",
      "options": [
        {
          "value": "eu",
          "label": "Europe"
        },
        {
          "value": "ca",
          "label": "Canada"
        },
        {
          "value": "us",
          "label": "États-Unis"
        }
      ]
    },
    "customerID": {
      "type": "string",
      "label": "Identifiant client OVH",
      "help": "De la forme ab12345-ovh, en haut à droite de l'espace client.",
      "required": true,
      "placeholder": "ab12345-ovh"
    },
    "password": {
      "type": "password",
      "label": "Mot de passe",
      "required": true
    },
    "mfa": {
      "type": "totp",
      "label": "Secret de double authentification",
      "help": "Facultatif. Le secret affiché à l'activation de la 2FA, ou le lien otpauth:// complet."
    }
  },
  "autofill": true,
  "checkAuth": [
    {
      "action": "navigate",
      "url": "https://manager.{{config.region}}.ovhcloud.com/#/billing/history",
      "description": "Non connecté, OVH redirige vers auth.<région>.ovhcloud.com ; c'est ce que la vérification d'URL détecte."
    },
    {
      "action": "waitForNetworkIdle",
      "idleMs": 800,
      "timeout": 25000
    },
    {
      "action": "checkURL",
      "url": "https://manager.*.ovhcloud.com/*",
      "description": "Vérifié : rester sur le manager signifie connecté, être renvoyé sur auth. signifie déconnecté."
    }
  ],
  "startAuth": [
    {
      "action": "navigate",
      "url": "https://www.ovh.com/auth/",
      "description": "Redirige vers auth.<région>.ovhcloud.com/signin/"
    },
    {
      "action": "waitForElement",
      "selector": "#account",
      "timeout": 20000
    },
    {
      "action": "type",
      "selector": "#account",
      "value": "{{config.customerID}}",
      "description": "Vérifié : utiliser l'id, pas le name. OVH randomise l'attribut name du champ (name=\"6736c45e\" à une visite, autre chose à la suivante), et input[name='account'] désigne en réalité le champ « mot de passe oublié »."
    },
    {
      "action": "type",
      "selector": "#password",
      "value": "{{secret.password}}",
      "description": "Vérifié : même raison, le name est randomisé."
    },
    {
      "action": "click",
      "selector": "#login-submit",
      "description": "Vérifié : bouton « Se connecter »"
    },
    {
      "action": "waitForNavigation",
      "timeout": 30000
    },
    {
      "action": "if",
      "condition": {
        "elementExists": "input[autocomplete='one-time-code'], #totpCode, input[name='totpCode'], #emailCode, #smsCode, #backupCode, input[placeholder='Code'], form input[type='text']:not(#account):not(#lost-account)"
      },
      "then": [
        {
          "action": "type",
          "selector": "input[autocomplete='one-time-code'], #totpCode, input[name='totpCode'], #emailCode, #smsCode, #backupCode, input[placeholder='Code'], form input[type='text']:not(#account):not(#lost-account)",
          "value": "{{totp.mfa}}",
          "pressEnter": true,
          "description": "Écran « Validation en deux étapes ». L'union couvre les variantes d'OVH ; si aucune ne correspond, l'utilisateur saisit le code lui-même et l'app capture la structure de la page pour corriger le sélecteur."
        },
        {
          "action": "waitForNavigation",
          "timeout": 30000
        }
      ]
    }
  ],
  "getDocuments": [
    {
      "action": "navigate",
      "url": "https://manager.{{config.region}}.ovhcloud.com/#/billing/history"
    },
    {
      "action": "waitForNetworkIdle",
      "idleMs": 1200,
      "timeout": 30000
    },
    {
      "action": "waitForElement",
      "selector": "table tbody tr",
      "timeout": 25000,
      "description": "NON VÉRIFIÉ à partir d'ici : voir ovh.NOTES.md pour confirmer ces sélecteurs en dix minutes."
    },
    {
      "action": "extractAll",
      "selector": "table tbody tr",
      "limit": 60,
      "fields": {
        "billId": {
          "selector": "td:nth-child(1)"
        },
        "date": {
          "selector": "td:nth-child(2)"
        },
        "total": {
          "selector": "td:nth-child(4)"
        },
        "pdf": {
          "selector": "a[href*='pdf'], a[download]",
          "attribute": "href"
        }
      },
      "forEach": [
        {
          "action": "downloadPdf",
          "url": "{{item.pdf}}",
          "timeout": 60000,
          "document": {
            "id": "{{item.billId}}",
            "date": "{{item.date}}",
            "total": "{{item.total}}",
            "number": "{{item.billId}}",
            "issuer": "OVHcloud",
            "currency": "EUR"
          }
        }
      ]
    }
  ]
}
