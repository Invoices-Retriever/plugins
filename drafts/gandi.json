{
  "$schema": "../schema/plugin-v1.schema.json",
  "id": "gandi",
  "name": "Gandi",
  "version": "0.1.0",
  "description": "Factures Gandi (noms de domaine, hébergement). Brouillon non vérifié sur un compte réel.",
  "homepage": "https://www.gandi.net",
  "country": ["FR", "EU"],
  "tags": ["domains", "hosting"],
  "engine": ">=1.0.0",
  "allowedDomains": ["gandi.net", "*.gandi.net"],
  "configSchema": {
    "username": { "type": "string", "label": "Identifiant ou e-mail", "required": true },
    "password": { "type": "password", "label": "Mot de passe", "required": true },
    "mfa": { "type": "totp", "label": "Secret de double authentification" }
  },
  "autofill": true,
  "checkAuth": [
    { "action": "navigate", "url": "https://admin.gandi.net/billing/invoices" },
    { "action": "waitForNetworkIdle", "idleMs": 800, "timeout": 25000 },
    { "action": "checkURL", "url": "*admin.gandi.net/billing*" }
  ],
  "startAuth": [
    { "action": "navigate", "url": "https://id.gandi.net/login" },
    {
      "action": "waitForElement",
      "selector": "input[name='username'], input[type='email']",
      "timeout": 20000
    },
    {
      "action": "type",
      "selector": "input[name='username'], input[type='email']",
      "value": "{{config.username}}"
    },
    { "action": "type", "selector": "input[type='password']", "value": "{{secret.password}}" },
    { "action": "click", "selector": "button[type='submit']" },
    { "action": "waitForNavigation", "timeout": 30000 },
    {
      "action": "if",
      "condition": { "elementExists": "input[name='totp'], input[autocomplete='one-time-code']" },
      "then": [
        {
          "action": "type",
          "selector": "input[autocomplete='one-time-code']",
          "value": "{{totp.mfa}}",
          "pressEnter": true
        },
        { "action": "waitForNavigation", "timeout": 30000 }
      ]
    }
  ],
  "getDocuments": [
    { "action": "navigate", "url": "https://admin.gandi.net/billing/invoices" },
    { "action": "waitForElement", "selector": "table tbody tr", "timeout": 25000 },
    {
      "action": "extractAll",
      "selector": "table tbody tr",
      "limit": 60,
      "fields": {
        "number": { "selector": "td:nth-child(1)" },
        "date": { "selector": "td:nth-child(2)" },
        "total": { "selector": "td:nth-child(3)" },
        "pdf": { "selector": "a[href*='pdf'], a[download]", "attribute": "href" }
      },
      "forEach": [
        {
          "action": "downloadPdf",
          "url": "{{item.pdf}}",
          "timeout": 60000,
          "document": {
            "id": "{{item.number}}",
            "date": "{{item.date}}",
            "total": "{{item.total}}",
            "number": "{{item.number}}",
            "issuer": "Gandi",
            "currency": "EUR"
          }
        }
      ]
    }
  ]
}
